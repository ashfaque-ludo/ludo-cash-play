# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/build/
backend/dist/

# Environment files
.env
.env.local
.env.production
frontend/.env
frontend/.env.local
backend/.env
backend/.env.production
# Allow frontend/.env.production so REACT_APP_BACKEND_URL is baked in at build time
!frontend/.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Uploads (user-uploaded files — not in source control)
backend/uploads/

# Runtime
backend/.cache/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyc
