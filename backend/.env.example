# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ludocashplay
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/ludocashplay

# JWT
JWT_SECRET=replace-with-minimum-64-character-random-string-generate-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend.onrender.com

# Platform commission (overridden at runtime via Admin > Payment Settings)
PLATFORM_COMMISSION_PCT=5

# ── Firebase Admin SDK ──────────────────────────────────────────────────────
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate new private key" → downloads JSON
# 3. Base64-encode it:
#    Mac/Linux:  base64 -i firebase-service-account.json | tr -d '\n'
#    Windows PS: [Convert]::ToBase64String([IO.File]::ReadAllBytes("firebase-service-account.json"))
# 4. Paste the one-line output as the value below (also add to Render env vars)
FIREBASE_SERVICE_ACCOUNT=

# ── API-King SMS OTP (backend fallback used when Firebase phone auth fails) ─
# Get this from your API-King dashboard. Sent as the raw Authorization header
# value (no "Bearer " prefix) — never expose this to the frontend.
API_KING_API_KEY=

# ── Optional: Legacy SMS fallback (not needed when Firebase is configured) ──
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Super-admin seed
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=YourStrongPassword
SUPER_ADMIN_NAME=Master Owner
